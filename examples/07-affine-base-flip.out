o15 = -
      2

o15 : QQ

i16 : contraction = canonicalContractionData(Y, 2);

i17 : contraction#"contractionType"

o17 = birational

i18 : contraction#"steinFactorizationType"

o18 = structure morphism to the affine base

i19 : contraction#"affineBaseDimension"

o19 = 3

i20 : dim(contraction#"steinAlgebraData"#"ring")

