i4 : relativeModel = (fibreGenerators, letter) -> (
         n := #fibreGenerators;
         S := QQ[p_1 .. p_5, (getSymbol letter)_1 .. (getSymbol letter)_n,
             Degrees => join(toList(5:0), toList(n:1))];
         S/ker map(monomials4, S, baseGenerators | fibreGenerators))

o4 = relativeModel

o4 : FunctionClosure

i5 : X = relativeModel({et, ec*et, eb*ec^2*et, eb^2*ec^3*et, ea*ec^2*et,
         ea*eb*ec^3*et}, "q")

o5 = X

